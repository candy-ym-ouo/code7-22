# Build the Vue SPA and serve it with nginx. Build context is the repo root.
FROM node:22-bookworm-slim AS build
ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable
WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/shared/package.json packages/shared/
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile --config.confirmModulesPurge=false

COPY packages/shared ./packages/shared
COPY apps/web ./apps/web
# VITE_TILE_URL and other VITE_* values must be provided as build args so they
# are baked into the production bundle.
ARG VITE_TILE_URL
ENV VITE_TILE_URL=$VITE_TILE_URL
RUN pnpm --filter @map/web build

FROM nginx:1.27-alpine AS runtime
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
COPY infra/nginx/default.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
