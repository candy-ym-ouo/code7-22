# Shared runtime image for the Node services (api, worker, db CLI).
# Build context is the repository root so the pnpm workspace can be installed.
FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable
WORKDIR /app

# ---- dependencies + build (compiled output is type-checked via tsc) ----
FROM base AS build
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/shared/package.json packages/shared/
COPY packages/db/package.json packages/db/
COPY apps/api/package.json apps/api/
COPY apps/worker/package.json apps/worker/
# sharp ships prebuilt binaries; do not run its install scripts here
RUN pnpm install --frozen-lockfile --config.confirmModulesPurge=false

COPY packages ./packages
COPY apps ./apps
# Run type checking across the workspace; the services run from TS via tsx,
# so this is the gate that guarantees the image contains valid code.
RUN pnpm --filter @map/shared typecheck \
  && pnpm --filter @map/db typecheck \
  && pnpm --filter @map/api typecheck \
  && pnpm --filter @map/worker typecheck

# ---- runtime ----
FROM base AS runtime
ENV NODE_ENV=production
# Copy the whole workspace: pnpm relies on symlinks into node_modules/.pnpm.
COPY --from=build /app /app
WORKDIR /app

# The image is role-agnostic; the compose file picks the entry command.
# Default to the API so an accidental `docker run` still serves something sane.
EXPOSE 3000
CMD ["pnpm", "--filter", "@map/api", "start"]
