{
  "name": "public-space-detail-map",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,worker,web -c blue,magenta,green \"pnpm --filter @map/api dev\" \"pnpm --filter @map/worker dev\" \"pnpm --filter @map/web dev\"",
    "build": "pnpm -r run --if-present build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @map/db test:e2e",
    "verify": "pnpm lint && pnpm test && pnpm build",
    "db:migrate": "pnpm --filter @map/db migrate",
    "db:rollback": "pnpm --filter @map/db rollback",
    "db:status": "pnpm --filter @map/db status",
    "db:seed": "pnpm --filter @map/db seed",
    "admin:create": "pnpm --filter @map/db admin:create"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2"
  }
}
