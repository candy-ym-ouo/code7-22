# ─────────────────────────────────────────────────────────────────────────────
# 公共空间细节地图 — 唯一环境变量样例
#
# 本地开发：cp .env.example .env（本文件的值即面向本机服务的默认值）。
# 容器部署：docker compose 会用服务名（postgres/redis/minio…）覆盖主机名，
#          密钥与功能开关仍然来自同一份变量，校验规则与启动检查完全相同。
#
# 生产要求：
# - NODE_ENV=production
# - 更换所有密钥（启动期会拒绝已知占位/弱密钥）
# - COOKIE_SECURE=true，对外 Origin 使用 https
# - VITE_TILE_URL 指向自托管或获授权的瓦片服务
# ─────────────────────────────────────────────────────────────────────────────

# 运行时
NODE_ENV=development
PORT=3000
# 空值使用默认级别（生产 info、其他 debug）；可选 fatal/error/warn/info/debug/trace/silent
LOG_LEVEL=

# 前端来源与 API 地址（浏览器可见，生产必须 https）
APP_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000/api/v1
COOKIE_SECURE=false

# PostgreSQL/PostGIS
DATABASE_URL=postgres://map:map@localhost:5432/map
POSTGRES_USER=map
POSTGRES_PASSWORD=map
POSTGRES_DB=map

# Redis（BullMQ 与限流）
REDIS_URL=redis://localhost:6379/0

# S3/MinIO
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_QUARANTINE_BUCKET=map-quarantine
S3_PUBLIC_BUCKET=map-public
PUBLIC_MEDIA_BASE_URL=http://localhost:9000/map-public
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# 访问令牌（至少 32 字符；下列占位值生产环境会被启动校验拒绝）
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL=10m
REFRESH_TOKEN_TTL_DAYS=30

# 投稿与媒体限制
MEDIA_MAX_BYTES=10485760
MEDIA_MAX_PER_FEATURE=6
MEDIA_MAX_PIXELS=20000000
PRIVACY_DETECTOR_URL=
PRIVACY_BLUR_SIGMA=32
PRIVACY_BLUR_PADDING=0.08
ORIGINAL_RETENTION_HOURS=24

# ClamAV（仅可在非媒体开发时关闭；生产必须开启）
CLAMAV_ENABLED=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# SMTP（本地使用 Mailpit）
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=公共空间细节地图 <noreply@example.test>

# Worker 健康探针端口
WORKER_HEALTH_PORT=3100

# Web 构建期变量
# 生产环境不能依赖公共瓦片：
VITE_TILE_URL=
VITE_MAP_STYLE_URL=
VITE_MAP_GLYPHS_URL=
VITE_DEFAULT_MAP_CENTER=116.39,39.90
VITE_DEFAULT_MAP_ZOOM=12

# Caddy（容器反向代理）
DOMAIN=localhost
STORAGE_DOMAIN=storage.localhost
