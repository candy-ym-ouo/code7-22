# 公共空间细节地图 — 环境变量样例
#
# 用法：cp .env.example .env，然后填入本地/生产值。
# 所有进程（API、Worker、packages/db 下的 migrate/rollback/status/seed/admin CLI）
# 都从同一个 .env 加载，保证开发、测试与生产的配置解析结果一致。
# 标记 [required in prod] 的变量在 NODE_ENV=production 下必须显式提供强值，
# 启动校验会拒绝默认值、占位符和弱密钥。

# ---- 运行环境 ----
NODE_ENV=development
# 发布版本（镜像 tag 或 release SHA），会出现在日志与 /health/ready 中
APP_VERSION=0.0.0-dev
# 日志级别：trace|debug|info|warn|error|fatal（生产默认 info）
LOG_LEVEL=debug

# ---- API ----
PORT=3000
APP_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000/api/v1
# 生产必须为 true（HTTPS）
COOKIE_SECURE=false
# [required in prod] 至少 32 个字符；禁止包含 example/change-me/development 等占位词
JWT_ACCESS_SECRET=development-only-access-secret-do-not-use-in-production-0001
ACCESS_TOKEN_TTL=10m
REFRESH_TOKEN_TTL_DAYS=30
MEDIA_MAX_BYTES=10485760
MEDIA_MAX_PER_FEATURE=6

# ---- Worker ----
# Worker 健康探针端口（/health/live、/health/ready）
WORKER_PORT=3100
MEDIA_MAX_PIXELS=20000000
PRIVACY_DETECTOR_URL=
PRIVACY_BLUR_SIGMA=32
PRIVACY_BLUR_PADDING=0.08
ORIGINAL_RETENTION_HOURS=24
CLAMAV_ENABLED=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=公共空间细节地图 <noreply@example.test>

# ---- PostgreSQL / PostGIS ----
# [required in prod]
DATABASE_URL=postgres://map:map@localhost:5432/map
# 启动时等待数据库可达的最长秒数
DB_CONNECT_TIMEOUT_SECONDS=30

# ---- Redis / BullMQ ----
REDIS_URL=redis://localhost:6379/0

# ---- S3 / MinIO ----
# [required in prod] 生产建议指向 https:// 端点
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=map
S3_SECRET_KEY=map
S3_QUARANTINE_BUCKET=map-quarantine
S3_PUBLIC_BUCKET=map-public
# [required in prod] 必须是 https:// CDN/公开桶地址
PUBLIC_MEDIA_BASE_URL=http://localhost:9000/map-public

# ---- 健康检查 ----
# 单个依赖探针的超时（毫秒）
HEALTH_CHECK_TIMEOUT_MS=2000

# ---- 迁移（可选） ----
# 仅在确认已应用迁移文件与发行包不一致是预期行为时置为 true，默认拒绝漂移
MIGRATE_ALLOW_DRIFT=false

# ---- 前端构建（Vite，见 apps/web）----
VITE_TILE_URL=
